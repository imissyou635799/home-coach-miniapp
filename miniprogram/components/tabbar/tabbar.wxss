.tabbar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 18rpx;
  height: 104rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 -8rpx 30rpx rgba(19, 39, 65, 0.12);
  z-index: 20;
}

.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #52616f;
  font-size: 22rpx;
}

.tab.active {
  color: #0e3a5a;
  font-weight: 800;
}

.icon {
  font-size: 38rpx;
  line-height: 1;
}
