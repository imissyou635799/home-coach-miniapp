page {
  min-height: 100vh;
  background: #f5f7fb;
  color: #17334a;
  font-family: -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 140rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 28rpx rgba(18, 38, 63, 0.08);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 28rpx 0 18rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #17334a;
}

.section-title::before {
  content: "";
  width: 6rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: #f6a623;
}

.primary-btn {
  height: 76rpx;
  border-radius: 16rpx;
  background: #0e3a5a;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.muted {
  color: #6b7a89;
}
