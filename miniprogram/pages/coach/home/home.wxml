<view class="coach-page">
  <view class="hero">
    <view class="hero-top">
      <view class="brand">上门体育</view>
      <view class="bell">🔔</view>
    </view>
    <view class="coach-info">
      <view class="avatar">🏅</view>
      <view>
        <view class="coach-name">{{dashboard.coach.name || '教练'}}</view>
        <view class="member">● 会员有效期至 {{dashboard.coach.memberExpireAt || '未开通'}}</view>
      </view>
    </view>
  </view>

  <swiper class="banner" autoplay circular indicator-dots>
    <swiper-item wx:for="{{dashboard.banners}}" wx:key="id">
      <view class="banner-card">
        <view class="banner-label">自媒体获客</view>
        <view class="banner-title">{{item.title}}</view>
        <view class="banner-sub">{{item.subtitle}}</view>
        <view class="banner-btn">{{item.buttonText}}</view>
      </view>
    </swiper-item>
  </swiper>

  <view class="section-title">快捷操作</view>
  <view class="quick card">
    <view class="quick-item" wx:for="{{actions}}" wx:key="text" bindtap="quickTap" data-action="{{item.text}}">
      <view class="quick-icon">{{item.icon}}</view>
      <view>{{item.text}}</view>
    </view>
  </view>

  <view class="section-title">今日课程</view>
  <view wx:if="{{dashboard.todayLessons.length === 0}}" class="empty card">今天还没有课程记录</view>
  <view wx:for="{{dashboard.todayLessons}}" wx:key="id" class="lesson card">
    <view class="lesson-time">⏱ {{item.startTime}} - {{item.endTime}}</view>
    <view class="lesson-name">👦 {{item.student.name}}（{{item.package.name}}）</view>
    <view class="lesson-content">今日内容：{{item.content}}</view>
    <view class="lesson-meta">
      <text>剩余 {{item.package.remainingLessons}} 次</text>
      <text>已消 {{item.package.usedLessons}} 次</text>
    </view>
  </view>

  <app-tabbar role="coach" active="home"></app-tabbar>
</view>
