.form {
  display: grid;
  gap: 18rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
}

input,
.picker {
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #f5f7fb;
  display: flex;
  align-items: center;
}

.row,
.student,
.empty {
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.row-title {
  font-size: 30rpx;
  font-weight: 900;
}

.pkg {
  margin-top: 14rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  background: #edf7ff;
  color: #0e3a5a;
}
