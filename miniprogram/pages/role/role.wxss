.role-page {
  min-height: 100vh;
  padding: 140rpx 54rpx 60rpx;
  box-sizing: border-box;
  color: #fff;
  background: radial-gradient(circle at 80% 4%, rgba(255, 255, 255, 0.12), transparent 180rpx), linear-gradient(180deg, #194f75 0%, #08263d 100%);
}

.brand {
  text-align: center;
  margin-bottom: 120rpx;
}

.logo {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 34rpx;
  border-radius: 34rpx;
  display: grid;
  place-items: center;
  background: linear-gradient(180deg, #ffc04d, #f6a623);
  color: #102b3d;
  font-size: 54rpx;
  font-weight: 900;
}

.name {
  font-size: 54rpx;
  font-weight: 900;
}

.sub {
  margin-top: 12rpx;
  color: #c8dbea;
  font-size: 24rpx;
}

.choose {
  text-align: center;
  color: #d8e6f0;
  margin-bottom: 42rpx;
}

.role-card {
  height: 152rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 32rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.12);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

.role-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  display: grid;
  place-items: center;
  font-size: 46rpx;
}

.medal {
  background: #f6a623;
}

.parent {
  background: #37b7ff;
}

.role-copy {
  flex: 1;
}

.role-title {
  font-size: 34rpx;
  font-weight: 900;
}

.role-desc {
  margin-top: 8rpx;
  color: #c8dbea;
  font-size: 22rpx;
}

.arrow {
  color: #c8dbea;
  font-size: 42rpx;
}

.slogan {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 80rpx;
  text-align: center;
  color: #a9c1d3;
  font-size: 24rpx;
}
